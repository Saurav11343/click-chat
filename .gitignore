# Dependencies and generated web output
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/.cache/

# Environment variables and local overrides
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.local

# Secrets, private keys, certificates, and signing material
**/secrets/
**/.secrets/
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.mobileprovision

# Downloaded Google/Firebase/OAuth credentials and generated tokens
**/google-services.json
**/GoogleService-Info.plist
**/client_secret*.json
**/credentials*.json
**/*service-account*.json
**/serviceAccount*.json
**/token.json
**/tokens.json

# Android/Gradle local and generated files
**/local.properties
**/.gradle/
**/.externalNativeBuild/
**/.cxx/
**/captures/
**/*.apk
**/*.aab
**/*.aar
artifacts/

# Logs and diagnostics
**/logs/
**/*.log
**/*.hprof
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.idea/
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
**/.DS_Store
**/Thumbs.db
**/*.iml
**/*.suo
**/*.sw?
